{
  "name": "byeolbit-monorepo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:full": "docker compose up --build",
    "dev:backend": "docker compose up --build db backend",
    "build:frontend": "npm --workspace frontend run build",
    "deploy": "docker compose up --build -d",
    "stop": "docker compose down",
    "logs": "docker compose logs -f"
  }
}
